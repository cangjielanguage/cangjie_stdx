package stdx.contract.macros.generate

import stdx.contract.macros.parse.{parseFunctionContract}
import stdx.contract.macros.syntax.{FunctionClause, FunctionContract}
import stdx.contract.macros.tokens.tokensStableKey
import stdx.contract.macros.validation.{astGetOrDefault, callableBlock, validateFunctionContract, validateGhostUsage}
import std.ast.{ASTException, Block, DiagReportLevel, DoWhileExpr, Expr, ForInExpr, FuncDecl, IfExpr,
    LambdaExpr, MatchExpr, Node, PropDecl, SpawnExpr, StructDecl, SynchronizedExpr, Tokens, TryExpr, WhileExpr,
    diagReport, getChildMessages, setItem}
import std.collection.{ArrayList, forEach}

/**
 * @brief Publishes a property contract for the enclosing type contract to expand.
 *
 * Property contracts are expanded by the enclosing type contract: the property macro
 * publishes its attribute tokens and stable declaration key so the type-level
 * expansion can recover the deferred contract.
 *
 * @param property The property declaration carrying the contract.
 * @param attr The raw contract attribute tokens to defer.
 */
public func storeDeferredPropertyContract(property: PropDecl, attr: Tokens): Unit {
    let declTokens = property.toTokens()
    setItem("memberName", property.identifier.value)
    setItem("memberDeclFullKey", tokensStableKey(declTokens))
    setItem("memberAttr", attr)
}

/// Recover the deferred property attribute belonging to exactly this declaration.
/// The stable key decides, but the name must also match: two distinct declarations
/// can share a token-identical shape, and the name guard keeps them apart.
internal func findDeferredPropertyAttr(property: PropDecl): Tokens {
    let key = tokensStableKey(property.toTokens())
    let name = property.identifier.value
    for (message in getChildMessages("Contract")) {
        if (message.hasItem("memberName") && message.hasItem("memberDeclFullKey") &&
            message.hasItem("memberAttr") && message.getString("memberName") == name &&
            message.getString("memberDeclFullKey") == key) {
            return message.getTokens("memberAttr")
        }
    }
    Tokens()
}

/**
 * @brief Publishes a member contract for the enclosing type macro to generate.
 *
 * Members inside a type contract are generated by the enclosing type macro;
 * publish the attribute and the stable declaration key so it can be recovered.
 *
 * @param method The method declaration carrying the contract.
 * @param attr The raw contract attribute tokens to defer.
 */
public func storeDeferredMethodContract(method: FuncDecl, attr: Tokens): Unit {
    let declTokens = method.toTokens()
    setItem("memberName", method.identifier.value)
    setItem("memberDeclFullKey", tokensStableKey(declTokens))
    setItem("memberAttr", attr)
}

internal func findDeferredMethodAttr(method: FuncDecl): Tokens {
    let key = tokensStableKey(method.toTokens())
    let name = method.identifier.value
    for (message in getChildMessages("Contract")) {
        // Name plus stable key: the key alone can collide for token-identical declarations.
        if (message.hasItem("memberName") && message.hasItem("memberDeclFullKey") &&
            message.hasItem("memberAttr") && message.getString("memberName") == name &&
            message.getString("memberDeclFullKey") == key) {
            return message.getTokens("memberAttr")
        }
    }
    Tokens()
}

/**
 * @brief Lowers the contracts of local functions declared inside a function body.
 *
 * A `@Contract` on a local function cannot tell whether the enclosing context is a
 * type or a function, so it defers the attribute; the enclosing function absorbs it
 * before its own generation.
 *
 * @param owner The function whose body hosts the local functions.
 * @return `true` when any local function contract was lowered.
 */
public func absorbLocalFunctionContracts(owner: FuncDecl): Bool {
    astGetOrDefault(false) {=> absorbLocalContractsInBlock(owner.block)}
}

/**
 * @brief Lowers the contracts of local functions declared inside accessor bodies.
 *
 * A body-less (abstract) accessor — or a missing one — has nothing to lower:
 * reading `.block`, `.getter` or `.setter` of such a declaration throws
 * `ASTException`, which is swallowed and treated as nothing to lower.
 *
 * @param property The property whose accessor bodies host the local functions.
 * @return `true` when any local function contract was lowered.
 */
public func absorbPropertyLocalContracts(property: PropDecl): Bool {
    var changed = false
    try {
        if (absorbLocalFunctionContracts(property.getter)) {
            changed = true
        }
    } catch (_: ASTException) {
        ()
    }
    try {
        if (absorbLocalFunctionContracts(property.setter)) {
            changed = true
        }
    } catch (_: ASTException) {
        ()
    }
    changed
}

func absorbLocalContractsInBlock(block: Block): Bool {
    let (changed, rebuilt) = absorbLocalContractsInNodes(block.nodes)
    if (changed) {
        block.nodes = rebuilt
    }
    changed
}

/// Absorb local-function contracts declared anywhere in a statement list: directly in the
/// list, but also inside `if`/loop/`match`/`try`/`synchronized`/`spawn`/lambda bodies and
/// bare blocks, where the deferred attribute would otherwise be silently dropped by the
/// enclosing function.
func absorbLocalContractsInNodes(nodes: ArrayList<Node>): (Bool, ArrayList<Node>) {
    var changed = false
    let rebuilt = ArrayList<Node>()
    for (node in nodes) {
        if (let local: FuncDecl <- node) {
            // Rewrite deeper layers first so a lowered body already contains them.
            let absorbedNested = astGetOrDefault(false) {=> absorbLocalContractsInBlock(local.block)}
            let attr = findDeferredMethodAttr(local)
            if (attr.size > 0) {
                lowerLocalFunctionContract(local, attr, rebuilt)
                changed = true
                continue
            }
            if (absorbedNested) {
                changed = true
            }
            rebuilt.add(node)
            continue
        }
        if (absorbLocalContractsInChildren(node)) {
            changed = true
        }
        rebuilt.add(node)
    }
    (changed, rebuilt)
}

/// Recurse into the statement blocks nested in one non-declaration node.
func absorbLocalContractsInChildren(node: Node): Bool {
    match (node) {
        case expression: IfExpr => absorbLocalContractsInIf(expression)
        case expression: WhileExpr => absorbLocalContractsInBlock(expression.block)
        case expression: DoWhileExpr => absorbLocalContractsInBlock(expression.block)
        case expression: ForInExpr => absorbLocalContractsInBlock(expression.block)
        case expression: MatchExpr => absorbLocalContractsInMatch(expression)
        case expression: TryExpr => absorbLocalContractsInTry(expression)
        case expression: LambdaExpr => absorbLocalContractsInLambda(expression)
        case expression: SynchronizedExpr => absorbLocalContractsInBlock(expression.block)
        case expression: Block => absorbLocalContractsInBlock(expression)
        case expression: SpawnExpr => absorbLocalContractsInLambda(expression.lambdaExpr)
        case _ => false
    }
}

func absorbLocalContractsInIf(expression: IfExpr): Bool {
    var changed = absorbLocalContractsInBlock(expression.ifBlock)
    // The else branch accessor throws when absent; surface it as nothing to lower.
    let elseBranch: ?Expr = try {
        Some(expression.elseExpr)
    } catch (_: ASTException) {
        None
    }
    if (let Some(branch) <- elseBranch) {
        if (absorbLocalContractsInChildren(branch)) {
            changed = true
        }
    }
    changed
}

func absorbLocalContractsInMatch(expression: MatchExpr): Bool {
    var changed = false
    for (matchCase in expression.matchCases) {
        if (absorbLocalContractsInBlock(matchCase.block)) {
            changed = true
        }
    }
    changed
}

func absorbLocalContractsInTry(expression: TryExpr): Bool {
    var changed = absorbLocalContractsInBlock(expression.tryBlock)
    for (catchBlock in expression.catchBlocks) {
        if (absorbLocalContractsInBlock(catchBlock)) {
            changed = true
        }
    }
    // The finally accessor throws when absent; surface it as nothing to lower.
    let finallyBlock: ?Block = try {
        Some(expression.finallyBlock)
    } catch (_: ASTException) {
        None
    }
    if (let Some(block) <- finallyBlock) {
        if (absorbLocalContractsInBlock(block)) {
            changed = true
        }
    }
    changed
}

func absorbLocalContractsInLambda(expression: LambdaExpr): Bool {
    let (changed, rebuilt) = absorbLocalContractsInNodes(expression.nodes)
    if (changed) {
        expression.nodes = rebuilt
    }
    changed
}

/// Generate the contract lowering for one local function and append the resulting
/// declarations to `output`. Keeps the original declaration when generation fails.
func lowerLocalFunctionContract(local: FuncDecl, attr: Tokens, output: ArrayList<Node>): Unit {
    let parsed = parseFunctionContract(attr)
    parsed.diagnostics.forEach {diagnostic => diagnostic.show()}
    var contract: ?FunctionContract = None
    if (!parsed.hasError()) {
        let candidate = parsed.value
        if (validateFunctionContract(candidate, local)) {
            validateGhostUsage(candidate.clauses, callableBlock({=> local.block}), local.funcParams)
            if (declaresMemberInheritClause(candidate)) {
                diagReport(DiagReportLevel.ERROR, attr,
                    "inherited function contracts require an enclosing type contract",
                    "contract inheritance")
            } else {
                contract = Some(candidate)
            }
        }
    }
    match (contract) {
        case Some(parsedContract) =>
            try {
                let generated = genFunction(parsedContract, local)
                // Parsing through a throwaway declaration probes whether the generated body is
                // well-formed; a failure is a recoverable generator bug, not a reason to crash
                // the whole macro expansion.
                let probe = StructDecl(quote(struct ContractGenerated { $(generated) }))
                for (generatedDecl in probe.body.decls) {
                    output.add(generatedDecl)
                }
            } catch (e: Exception) {
                diagReport(DiagReportLevel.WARNING, Tokens(local.identifier),
                    "contract checks for the local function `${local.identifier.value}` were dropped (${e})",
                    "the generated contract body failed to re-parse; please report this case")
                output.add(local)
            }
        case None => output.add(local)
    }
}

/**
 * @brief Whether the member contract refers to a contract declared on a parent member.
 *
 * @param contract The parsed function contract to inspect.
 * @return `true` when the contract carries an inherit clause.
 */
public func declaresMemberInheritClause(contract: FunctionContract): Bool {
    for (clause in contract.clauses) {
        if (let FunctionClause.Inherit(_) <- clause) {
            return true
        }
    }
    false
}
